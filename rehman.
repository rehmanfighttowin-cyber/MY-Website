/* ===== Rehman Website - shared script ===== */
(function () {
  'use strict';

  var root = document.documentElement;

  /* ---------- Theme (dark / light) ---------- */
  function readTheme() {
    try { return localStorage.getItem('theme'); } catch (e) { return null; }
  }
  function writeTheme(v) {
    try { localStorage.setItem('theme', v); } catch (e) { /* ignore */ }
  }
  root.setAttribute('data-theme', readTheme() || 'dark');

  var themeBtn = document.getElementById('themeBtn');
  if (themeBtn) {
    themeBtn.addEventListener('click', function () {
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      writeTheme(next);
    });
  }

  /* ---------- Mobile menu ---------- */
  var menuBtn = document.getElementById('menuBtn');
  var links = document.getElementById('links');
  if (menuBtn && links) {
    menuBtn.addEventListener('click', function () { links.classList.toggle('open'); });
    links.addEventListener('click', function (e) {
      if (e.target.tagName === 'A') { links.classList.remove('open'); }
    });
  }

  /* ---------- Footer year ---------- */
  var yearEl = document.getElementById('year');
  if (yearEl) { yearEl.textContent = new Date().getFullYear(); }

  /* ---------- Scroll reveal ---------- */
  var revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) { en.target.classList.add('show'); io.unobserve(en.target); }
      });
    }, { threshold: 0.12 });
    revealEls.forEach(function (el) { io.observe(el); });
  } else {
    revealEls.forEach(function (el) { el.classList.add('show'); });
  }

  /* ---------- Card tilt (Apple-like) ---------- */
  var canHover = window.matchMedia && window.matchMedia('(hover: hover)').matches;
  if (canHover) {
    document.querySelectorAll('.tilt').forEach(function (card) {
      card.addEventListener('mousemove', function (e) {
        var r = card.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width - 0.5;
        var py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = 'perspective(900px) rotateX(' + (-py * 7).toFixed(2) +
          'deg) rotateY(' + (px * 7).toFixed(2) + 'deg) translateY(-4px)';
      });
      card.addEventListener('mouseleave', function () { card.style.transform = ''; });
    });
  }

  /* ---------- Galaxy mouse animation ---------- */
  var canvas = document.getElementById('galaxy');
  if (canvas && canvas.getContext) {
    var ctx = canvas.getContext('2d');
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var W = 0, H = 0, dpr = 1;
    var stars = [];
    var mouse = { x: -9999, y: -9999, active: false };
    var center = { x: 0, y: 0 };
    var REPEL = 140;
    var running = true;

    function rgb(name) {
      var v = getComputedStyle(root).getPropertyValue(name).trim();
      return v || '200, 220, 255';
    }

    function build() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = Math.floor(W * dpr);
      canvas.height = Math.floor(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      var count = Math.max(180, Math.min(850, Math.floor((W * H) / 2600)));
      var maxR = Math.max(W, H) * 0.62;
      stars = [];
      for (var i = 0; i < count; i++) {
        var r = Math.pow(Math.random(), 0.75) * maxR;
        var arm = i % 3;
        stars.push({
          r: r,
          a: arm * (Math.PI * 2 / 3) + r * 0.006 + (Math.random() - 0.5) * 0.7,
          s: 0.00018 / (1 + r / 220),
          size: 0.6 + Math.random() * 1.7,
          tw: Math.random() * Math.PI * 2,
          alt: Math.random() > 0.65,
          ox: 0, oy: 0, vx: 0, vy: 0
        });
      }
      center.x = W / 2;
      center.y = H / 2;
    }

    function frame(t) {
      if (!running) { return; }
      var starCol = rgb('--star');
      var altCol = rgb('--star2');

      var tx = W / 2, ty = H / 2;
      if (mouse.active) {
        tx += (mouse.x - W / 2) * 0.07;
        ty += (mouse.y - H / 2) * 0.07;
      }
      center.x += (tx - center.x) * 0.04;
      center.y += (ty - center.y) * 0.04;

      ctx.clearRect(0, 0, W, H);

      for (var i = 0; i < stars.length; i++) {
        var p = stars[i];
        var ang = p.a + (reduced ? 0 : t * p.s);
        var bx = center.x + Math.cos(ang) * p.r;
        var by = center.y + Math.sin(ang) * p.r * 0.55;

        if (mouse.active && !reduced) {
          var dx = bx + p.ox - mouse.x;
          var dy = by + p.oy - mouse.y;
          var d = Math.sqrt(dx * dx + dy * dy);
          if (d < REPEL && d > 0.01) {
            var f = (REPEL - d) / REPEL;
            p.vx += (dx / d) * f * 1.6;
            p.vy += (dy / d) * f * 1.6;
          }
        }
        p.vx += -p.ox * 0.035;
        p.vy += -p.oy * 0.035;
        p.vx *= 0.88;
        p.vy *= 0.88;
        p.ox += p.vx;
        p.oy += p.vy;

        var x = bx + p.ox;
        var y = by + p.oy;
        if (x < -10 || x > W + 10 || y < -10 || y > H + 10) { continue; }

        var alpha = 0.35 + 0.55 * Math.abs(Math.sin(p.tw + t * 0.0012));
        ctx.fillStyle = 'rgba(' + (p.alt ? altCol : starCol) + ',' + alpha.toFixed(2) + ')';
        ctx.beginPath();
        ctx.arc(x, y, p.size, 0, Math.PI * 2);
        ctx.fill();

        if (mouse.active && !reduced) {
          var mdx = x - mouse.x;
          var mdy = y - mouse.y;
          var md = Math.sqrt(mdx * mdx + mdy * mdy);
          if (md < 120) {
            ctx.strokeStyle = 'rgba(' + starCol + ',' + ((1 - md / 120) * 0.35).toFixed(2) + ')';
            ctx.lineWidth = 0.6;
            ctx.beginPath();
            ctx.moveTo(x, y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.stroke();
          }
        }
      }

      if (!reduced) { requestAnimationFrame(frame); }
    }

    window.addEventListener('pointermove', function (e) {
      mouse.x = e.clientX; mouse.y = e.clientY; mouse.active = true;
    }, { passive: true });
    window.addEventListener('pointerleave', function () { mouse.active = false; });
    document.addEventListener('mouseleave', function () { mouse.active = false; });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        build();
        if (reduced) { frame(0); }
      }, 150);
    });

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { running = false; }
      else if (!running) { running = true; requestAnimationFrame(frame); }
    });

    build();
    if (reduced) { frame(0); } else { requestAnimationFrame(frame); }
  }

  /* ---------- Contact form ---------- */
  var form = document.getElementById('contactForm');
  if (form) {
    var subjectSel = document.getElementById('subject');
    var status = document.getElementById('formStatus');
    var CONTACT_EMAIL = 'hello@rehman.dev'; /* <-- change to your real email */

    try {
      var params = new URLSearchParams(window.location.search);
      var map = { web: 'Web Developer', devops: 'DevOps', python: 'Python Development', other: 'Other' };
      var wanted = map[(params.get('subject') || '').toLowerCase()];
      if (wanted && subjectSel) { subjectSel.value = wanted; }
    } catch (e) { /* ignore */ }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = form.elements['name'].value.trim();
      var email = form.elements['email'].value.trim();
      var subject = form.elements['subject'].value;
      var message = form.elements['message'].value.trim();

      status.className = 'form-status';
      if (!name || !email || !subject || !message) {
        status.textContent = 'Please fill in all fields.';
        status.className = 'form-status err';
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.textContent = 'Please enter a valid email address.';
        status.className = 'form-status err';
        return;
      }

      var body = 'Name: ' + name + '\nEmail: ' + email + '\nService: ' + subject + '\n\n' + message;
      var href = 'mailto:' + CONTACT_EMAIL + '?subject=' + encodeURIComponent('[' + subject + '] New inquiry from ' + name) +
        '&body=' + encodeURIComponent(body);

      status.textContent = 'Thank you, ' + name + '! Your email app is opening with your message ready to send.';
      status.className = 'form-status ok';
      window.location.href = href;
      form.reset();
    });
  }
})();
