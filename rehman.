/* ===== Rehman Website - shared styles ===== */
:root,
[data-theme="dark"] {
  --bg: #000000;
  --bg-soft: #0b0b0f;
  --card: rgba(255, 255, 255, 0.06);
  --card-border: rgba(255, 255, 255, 0.12);
  --text: #f5f5f7;
  --muted: #a1a1a6;
  --accent: #2997ff;
  --accent2: #bf5af2;
  --nav-bg: rgba(10, 10, 14, 0.62);
  --shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
  --star: 200, 220, 255;
  --star2: 191, 140, 255;
}

[data-theme="light"] {
  --bg: #fbfbfd;
  --bg-soft: #f2f2f7;
  --card: rgba(255, 255, 255, 0.72);
  --card-border: rgba(0, 0, 0, 0.08);
  --text: #1d1d1f;
  --muted: #6e6e73;
  --accent: #0071e3;
  --accent2: #8e44ec;
  --nav-bg: rgba(251, 251, 253, 0.72);
  --shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
  --star: 40, 80, 160;
  --star2: 120, 60, 200;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  transition: background 0.4s ease, color 0.4s ease;
}

a { color: inherit; text-decoration: none; }
ul { list-style: none; }

#galaxy {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

main, footer, .nav { position: relative; z-index: 1; }

.container { width: min(1120px, 92%); margin: 0 auto; }

/* ===== Navigation ===== */
.nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--nav-bg);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid var(--card-border);
}
.nav-inner {
  width: min(1120px, 92%);
  margin: 0 auto;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo { font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em; }
.logo span { color: var(--accent); }
.links { display: flex; gap: 6px; }
.links a {
  padding: 8px 14px;
  border-radius: 980px;
  font-size: 0.92rem;
  color: var(--muted);
  transition: color 0.25s, background 0.25s;
}
.links a:hover { color: var(--text); background: var(--card); }
.links a.active { color: var(--text); background: var(--card); }
.nav-actions { display: flex; gap: 8px; align-items: center; }
.icon-btn {
  width: 38px; height: 38px;
  border-radius: 50%;
  border: 1px solid var(--card-border);
  background: var(--card);
  color: var(--text);
  font-size: 1.05rem;
  cursor: pointer;
  display: grid; place-items: center;
  transition: transform 0.25s, background 0.25s;
}
.icon-btn:hover { transform: scale(1.08); }
.menu-btn { display: none; }
.ico-moon { display: none; }
[data-theme="light"] .ico-sun { display: none; }
[data-theme="light"] .ico-moon { display: inline; }

/* ===== Buttons ===== */
.btn {
  display: inline-block;
  padding: 13px 26px;
  border-radius: 980px;
  font-size: 1rem;
  font-weight: 600;
  border: 1px solid transparent;
  cursor: pointer;
  transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
  font-family: inherit;
}
.btn:hover { transform: translateY(-2px); }
.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff;
  box-shadow: 0 10px 30px rgba(41, 151, 255, 0.28);
}
.btn-ghost {
  background: var(--card);
  border-color: var(--card-border);
  color: var(--text);
}

/* ===== Typography helpers ===== */
.eyebrow {
  display: inline-block;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 14px;
}
.gradient-text {
  background: linear-gradient(120deg, var(--accent), var(--accent2) 60%, #ff6bb5);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
h1 { font-size: clamp(2.5rem, 7vw, 5.2rem); line-height: 1.05; letter-spacing: -0.035em; font-weight: 700; }
h2 { font-size: clamp(1.9rem, 4.2vw, 3rem); line-height: 1.1; letter-spacing: -0.025em; font-weight: 700; }
h3 { font-size: 1.3rem; letter-spacing: -0.01em; margin-bottom: 8px; }
.lead { font-size: clamp(1.05rem, 2vw, 1.35rem); color: var(--muted); max-width: 680px; margin-top: 20px; }

/* ===== Sections ===== */
.hero { padding: 120px 0 90px; text-align: center; }
.hero .lead { margin-left: auto; margin-right: auto; }
.hero-cta { margin-top: 36px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
.page-hero { padding: 90px 0 40px; text-align: center; }
.page-hero .lead { margin-left: auto; margin-right: auto; }
.section { padding: 80px 0; }
.section-head { text-align: center; margin-bottom: 50px; }
.section-head .lead { margin-left: auto; margin-right: auto; }

.grid { display: grid; gap: 22px; }
.grid-3 { grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); }
.grid-4 { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
.grid-2 { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }

.card {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: 24px;
  padding: 32px;
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  transition: transform 0.2s ease-out, box-shadow 0.3s, border-color 0.3s;
  will-change: transform;
}
.card:hover { box-shadow: var(--shadow); border-color: rgba(41, 151, 255, 0.4); }
.card p { color: var(--muted); }
.card .badge {
  width: 52px; height: 52px;
  border-radius: 16px;
  display: grid; place-items: center;
  font-size: 1.6rem;
  margin-bottom: 18px;
  background: linear-gradient(135deg, rgba(41,151,255,0.25), rgba(191,90,242,0.25));
}
.card ul { margin-top: 16px; }
.card li {
  position: relative;
  padding-left: 24px;
  margin-bottom: 8px;
  color: var(--muted);
}
.card li::before {
  content: "";
  position: absolute; left: 0; top: 9px;
  width: 8px; height: 8px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
}
.card .card-link { display: inline-block; margin-top: 18px; color: var(--accent); font-weight: 600; }
.card .card-link:hover { text-decoration: underline; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 20px; margin-top: 70px; }
.stat { text-align: center; }
.stat strong { display: block; font-size: 2.6rem; letter-spacing: -0.03em; }
.stat span { color: var(--muted); font-size: 0.95rem; }

.steps { counter-reset: step; }
.step { position: relative; }
.step::before {
  counter-increment: step;
  content: "0" counter(step);
  display: block;
  font-size: 2.2rem; font-weight: 700;
  margin-bottom: 8px;
  background: linear-gradient(120deg, var(--accent), var(--accent2));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
}

.tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
.tag {
  padding: 8px 16px;
  border-radius: 980px;
  background: var(--card);
  border: 1px solid var(--card-border);
  font-size: 0.9rem;
}

.cta-band {
  text-align: center;
  padding: 70px 30px;
  border-radius: 32px;
  background: linear-gradient(135deg, rgba(41,151,255,0.18), rgba(191,90,242,0.18));
  border: 1px solid var(--card-border);
}
.cta-band .hero-cta { margin-top: 28px; }

/* ===== About ===== */
.about-wrap { display: grid; grid-template-columns: 1fr 1.4fr; gap: 50px; align-items: center; }
.avatar {
  aspect-ratio: 1 / 1;
  border-radius: 36px;
  display: grid; place-items: center;
  font-size: clamp(4rem, 12vw, 7rem);
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  box-shadow: var(--shadow);
}
.about-text p { color: var(--muted); margin-top: 16px; font-size: 1.08rem; }

.timeline { border-left: 2px solid var(--card-border); padding-left: 28px; margin-left: 8px; }
.tl-item { position: relative; padding-bottom: 32px; }
.tl-item::before {
  content: "";
  position: absolute; left: -37px; top: 6px;
  width: 14px; height: 14px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
}
.tl-item span { color: var(--accent); font-weight: 600; font-size: 0.9rem; }
.tl-item p { color: var(--muted); }

/* ===== Contact ===== */
.contact-wrap { display: grid; grid-template-columns: 1.3fr 1fr; gap: 28px; align-items: start; }
form label { display: block; font-size: 0.9rem; font-weight: 600; margin: 18px 0 8px; }
form input, form select, form textarea {
  width: 100%;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid var(--card-border);
  background: var(--bg-soft);
  color: var(--text);
  font-size: 1rem;
  font-family: inherit;
  outline: none;
  transition: border-color 0.25s, box-shadow 0.25s;
}
form textarea { min-height: 150px; resize: vertical; }
form input:focus, form select:focus, form textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 4px rgba(41, 151, 255, 0.18);
}
form .btn { margin-top: 24px; width: 100%; }
.form-status { margin-top: 16px; font-weight: 600; min-height: 1.4em; }
.form-status.ok { color: #30d158; }
.form-status.err { color: #ff453a; }
.info-item { margin-bottom: 22px; }
.info-item small { color: var(--muted); display: block; font-size: 0.85rem; }
.info-item strong { font-size: 1.05rem; }

/* ===== Footer ===== */
footer { border-top: 1px solid var(--card-border); padding: 40px 0; margin-top: 60px; color: var(--muted); font-size: 0.92rem; }
.foot-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
.foot-links { display: flex; gap: 18px; }
.foot-links a:hover { color: var(--text); }

/* ===== Reveal animation ===== */
.reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease, transform 0.8s ease; }
.reveal.show { opacity: 1; transform: none; }
.no-js .reveal { opacity: 1; transform: none; }

/* ===== Responsive ===== */
@media (max-width: 820px) {
  .menu-btn { display: grid; }
  .links {
    position: absolute;
    top: 60px; left: 0; right: 0;
    flex-direction: column;
    background: var(--nav-bg);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    padding: 12px 4%;
    border-bottom: 1px solid var(--card-border);
    display: none;
  }
  .links.open { display: flex; }
  .about-wrap, .contact-wrap { grid-template-columns: 1fr; }
  .avatar { max-width: 260px; margin: 0 auto; }
  .hero { padding: 80px 0 60px; }
}

@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
  .reveal { opacity: 1; transform: none; }
